{
  "name": "@saitolume/git-mcp-server",
  "version": "0.1.0-beta.2",
  "description": "A constrained local Git MCP server for coding agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": { "node": ">=22" },
  "bin": { "git-mcp-server": "dist/cli.js" },
  "files": ["dist", "README.md", "README.ja.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saitolume/git-mcp-server.git"
  },
  "publishConfig": { "access": "public", "tag": "beta" },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "node --eval \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "pnpm test:compile && node --test .test-dist/test/*.test.js",
    "test:package-install": "pnpm build && pnpm test:compile && node --test .test-dist/test/package-install.integration.js",
    "check:git-version": "node scripts/check-git-version.mjs",
    "check:runtime-dependencies": "node scripts/check-runtime-dependencies.mjs",
    "check:publication": "node scripts/check-publication-readiness.mjs --repository .",
    "check": "pnpm check:git-version && pnpm check:runtime-dependencies && pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm clean && pnpm check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "@types/node": "22.20.0",
    "typescript": "7.0.2"
  }
}
